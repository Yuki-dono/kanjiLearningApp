# Copy to .env and fill in. NEVER commit .env — it holds a key that bypasses
# row-level security on every table.
#
# Where to get the service_role key:
#   Supabase Dashboard -> Project Settings -> API Keys
#   (listed as "service_role" / "sb_secret_...")

SUPABASE_URL=https://qkcquwbmmqgbvximphbz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claims we require on an access token. These match what Supabase issues.
JWT_AUDIENCE=authenticated

# Only needed if the static site is served from a different origin than the API.
# Comma-separated. Leave empty for same-origin (the default: the API serves the
# site too).
CORS_ORIGINS=